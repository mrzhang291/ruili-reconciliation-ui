# CherryStudio 企业版运行在接收人的本机；先在应用中启用 API 服务并创建对账 Agent
CHERRYSTUDIO_BASE_URL="http://127.0.0.1:24333"
CHERRYSTUDIO_API_KEY=""
CHERRYSTUDIO_DEFAULT_AGENT_NAME="锐力"
CHERRYSTUDIO_DEFAULT_AGENT_WORKSPACE=""
CHERRYSTUDIO_LOOKUP_TIMEOUT_MS=15000
CHERRYSTUDIO_REQUEST_TIMEOUT_MS=1200000
# QQ 邮箱 SMTP 授权码仅通过应用设置写入 Windows Credential Manager，不要填写在 .env 中。
# 此名称用于定位当前 Windows 用户的本机凭据，不含任何密码或授权码。
QQ_MAIL_CREDENTIAL_TARGET="BillCompare.QQMail.SMTP"
QQ_MAIL_TIMEOUT_MS=20000
# 飞书凭据由全局 lark-cli profile 管理；不要在此保存 App Secret、访问令牌或客户资源标识。
# 在本机环境文件中填写实际 Base 与数据表标识。
LARK_BASE_TOKEN=""
LARK_KNOWLEDGE_TABLE_ID=""
LARK_TASK_TABLE_ID=""
LARK_REVIEW_TABLE_ID=""
LARK_ERP_TABLE_ID=""
# 可选：不填时按表名自动定位，首次批量预检会自动创建
LARK_BATCH_TABLE_ID=""
LARK_BATCH_DOCUMENT_TABLE_ID=""
# Excel 结算单优先由后端本地读取；默认使用 PATH 中的 python，可按需指定绝对路径
EXCEL_READER_PYTHON="python"
# 所有运行时文件统一收口到项目根目录的 .runtime（该目录不会提交到 Git）
UPLOAD_DIR="../.runtime/data/uploads"
TASK_WORK_DIR="../.runtime/tasks"
PORT=3001
HOST="127.0.0.1"
ALLOWED_ORIGINS="http://127.0.0.1:3333,http://localhost:3333"
